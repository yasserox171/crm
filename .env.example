# ---------------------------------------------------------------------------
# Centre Focus CRM — copy to .env and fill in the values marked "change-me".
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Domain(s) or IP(s) used to reach the CRM, comma-separated.
DJANGO_ALLOWED_HOSTS=crm.example.ma
# Full origins (scheme + host [+ port]) allowed to POST forms.
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.ma
# 1 when the CRM sits behind an HTTPS reverse proxy (recommended).
DJANGO_BEHIND_HTTPS_PROXY=1
# Secure cookies need HTTPS. Set to 0 only for a temporary plain-HTTP test.
DJANGO_SECURE_COOKIES=1
TIME_ZONE=Africa/Casablanca
LOG_LEVEL=INFO

# First staff account, created on first start if it doesn't exist yet.
DJANGO_ADMIN_EMAIL=admin@example.ma
DJANGO_ADMIN_PASSWORD=change-me

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=focus_crm
POSTGRES_USER=focus
POSTGRES_PASSWORD=change-me

# --- Published port ---------------------------------------------------------
# 127.0.0.1 = only reachable from the server itself (put Nginx/Caddy + HTTPS in
# front). Use 0.0.0.0 to expose it directly.
HTTP_BIND=127.0.0.1
HTTP_PORT=8200

# --- WhatsApp ---------------------------------------------------------------
# "manual"         no API needed: each message opens pre-filled in WhatsApp
#                  (phone or WhatsApp Web) and you press Send; waiting messages
#                  are listed under "Messages à envoyer" on the Reminders page.
# "whatsapp_cloud" sent automatically through the Meta WhatsApp Business Cloud API.
# "whatsapp_web"   sent from a WhatsApp account you link by scanning a QR code
#                  (CRM → WhatsApp page). Unofficial: use a secondary number and
#                  low volumes. Also set COMPOSE_PROFILES and the token below.
# "console"        only logged, never sent (development / tests).
MESSAGING_BACKEND=manual
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Messages to people who haven't written to you in the last 24h must use an
# approved template whose body wraps one variable in fixed text, e.g.
# "Centre Focus : {{1}} Pour toute question, répondez à ce message." (a body that
# is only {{1}}, or starts/ends with it, is rejected by Meta). Put its name here.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr

# --- WhatsApp linked by QR code (MESSAGING_BACKEND=whatsapp_web) --------------
# Starts the internal `whatsapp` service. Leave empty if you don't use this mode.
COMPOSE_PROFILES=
# Shared secret between Django and the WhatsApp service:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_GATEWAY_TOKEN=
# Protect the number: few messages per day, spaced out randomly.
WA_WEB_DAILY_LIMIT=40
WA_WEB_MIN_DELAY_SECONDS=20
WA_WEB_MAX_DELAY_SECONDS=45

# --- AI post drafting (optional) --------------------------------------------
# Leave empty to disable the "Generate with AI" button.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Centre -----------------------------------------------------------------
CENTER_NAME=Centre Focus
CENTER_CITY=Safi

# --- Tuning -----------------------------------------------------------------
WEB_CONCURRENCY=3
WORKER_INTERVAL_SECONDS=2
AUTOMATION_INTERVAL_SECONDS=60
MAX_BULK_RECIPIENTS=500
CONTENT_MEDIA_MAX_MB=50
